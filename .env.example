# Environment Configuration Example for Waypoint

# Node Environment
NODE_ENV=development

# Database (PostgreSQL - e.g. Neon, Supabase, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/waypoint?sslmode=prefer"

# Auth.js / NextAuth
AUTH_SECRET="generate_a_random_32_character_secret_with_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"

# Google OAuth (Optional in dev, required for Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob (Optional in dev, required for file/avatar uploads)
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron Secret (Protects scheduled endpoints)
CRON_SECRET="dev_cron_secret"

# Demo Mode Flag (Enables simulated emails, demo outbox, try-demo buttons)
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
