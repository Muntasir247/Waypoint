# Environment Configuration Example for Waypoint

# Node Environment
NODE_ENV=development

# Database (Turso LibSQL or local SQLite)
DATABASE_URL="libsql://waypoint-muntasir247.aws-ap-southeast-1.turso.io"
TURSO_DATABASE_URL="libsql://waypoint-muntasir247.aws-ap-southeast-1.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# Auth.js / NextAuth
AUTH_SECRET="generate_a_random_32_character_secret_with_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"

# Google OAuth (Optional in development)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob (Optional in dev, required for file/avatar uploads)
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron Secret (Protects scheduled endpoints)
CRON_SECRET="dev_cron_secret"

# Demo Mode Flag (Set to "false" for production/real-user usage)
NEXT_PUBLIC_DEMO_MODE="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
